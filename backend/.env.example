DJANGO_SECRET_KEY=cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# DB_ENGINE=sqlite para uso personal (no hace falta levantar un Postgres).
# Con sqlite solo se usa DB_NAME, y su default es backend/db.sqlite3.
DB_ENGINE=postgresql
DB_NAME=web_uni
DB_USER=web_uni
DB_PASSWORD=web_uni
DB_HOST=localhost
DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Apuntes y grabaciones (Proceso 04)
MEDIA_ROOT=media
APUNTES_TAMANO_MAXIMO_MB=200
